datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

model Tenant {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenantApplications TenantApplication[]
    users              User[]
}

model Application {
    id Int @id @default(autoincrement())

    code        String  @unique
    name        String  @unique
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenantApplications TenantApplication[]
}

model TenantApplication {
    id Int @id @default(autoincrement())

    key String @unique

    tenantId Int
    tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    applicationId Int
    application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users                    TenantApplicationUser[]
    authenticationStrategies TenantApplicationAuthenticationStrategy[]

    @@unique([id, tenantId])
    @@unique([tenantId, applicationId])
    @@index([applicationId])
}

model User {
    id Int @id @default(autoincrement())

    email        String
    phoneNumber  String?
    username     String
    passwordHash String

    emailVerified Boolean @default(false)
    phoneVerified Boolean @default(false)

    tenantId Int
    tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    applications      TenantApplicationUser[]
    totpAuthenticator TotpAuthenticator?

    @@unique([id, tenantId])
    @@unique([tenantId, email])
    @@unique([tenantId, username])
    @@unique([tenantId, phoneNumber])
    @@index([tenantId])
}

model TenantApplicationUser {
    id Int @id @default(autoincrement())

    tenantId Int

    userId Int
    user   User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

    tenantApplicationId Int
    tenantApplication   TenantApplication @relation(fields: [tenantApplicationId, tenantId], references: [id, tenantId], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sessions Session[]

    @@unique([userId, tenantApplicationId])
    @@index([tenantApplicationId])
}

model Session {
    id Int @id @default(autoincrement())

    tokenHash String @unique

    tenantApplicationUserId Int
    tenantApplicationUser   TenantApplicationUser @relation(fields: [tenantApplicationUserId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    expiresAt DateTime

    @@index([tenantApplicationUserId])
    @@index([expiresAt])
}

enum AuthenticationStrategy {
    EMAIL_PASSWORD
    USERNAME_PASSWORD

    EMAIL_PASSWORD_EMAIL_OTP
    EMAIL_PASSWORD_PHONE_OTP
    EMAIL_PASSWORD_TOTP

    USERNAME_PASSWORD_EMAIL_OTP
    USERNAME_PASSWORD_PHONE_OTP
    USERNAME_PASSWORD_TOTP

    GOOGLE_SSO
    AZURE_SSO
}

model TenantApplicationAuthenticationStrategy {
    id Int @id @default(autoincrement())

    tenantApplicationId Int
    tenantApplication   TenantApplication @relation(fields: [tenantApplicationId], references: [id], onDelete: Cascade)

    strategy AuthenticationStrategy

    enabled Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([tenantApplicationId, strategy])
    @@index([tenantApplicationId])
}

model TotpAuthenticator {
    id Int @id @default(autoincrement())

    userId Int  @unique
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    label            String?
    encryptedSecret  String
    verified         Boolean @default(false)
    lastUsedTimeStep BigInt?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
