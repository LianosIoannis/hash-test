datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

model Client {
    id Int @id @default(autoincrement())

    name        String
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model User {
    id Int @id @default(autoincrement())

    email        String @unique
    passwordHash String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
